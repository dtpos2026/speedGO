# Copy to .env if you want to override defaults. Nothing here is required for local use.
PORT=4000
# dev = fixed OTP code 123456 (LOCAL ONLY). sms = real SMS provider (not implemented yet).
OTP_MODE=dev
# off = use straight-line distance estimates instead of the public OSRM routing server
ROUTING=on
# off = disable address search (you can still tap the map)
GEOCODER=on
# Set these to run your own routing / geocoding servers later
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# First admin account (if empty, a random password is generated and printed once)
# SEED_ADMIN_EMAIL=admin@speedgo.local
# SEED_ADMIN_PASSWORD=
